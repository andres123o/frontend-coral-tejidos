# URL del backend FastAPI (local: http://localhost:8000, prod: la URL de Railway)
VITE_API_URL=http://localhost:8000

# Número de WhatsApp de la tienda en formato internacional sin '+' ni espacios, ej: 573001234567
VITE_WHATSAPP_NUMBER=573001234567

# Supabase Auth (login del panel /admin). Solo la anon key, que es segura de exponer
# en el navegador (Project Settings -> API -> Project URL / anon public key).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key
